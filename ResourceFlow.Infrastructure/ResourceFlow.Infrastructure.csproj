	<!-- Project References -->
	<ItemGroup>
		<ProjectReference Include="..\ResourceFlow.Application\ResourceFlow.Application.csproj" />
		<ProjectReference Include="..\ResourceFlow.Domain\ResourceFlow.Domain.csproj" />
	</ItemGroup>

	<!-- Folder Structure -->

	<!-- SQL File Copy -->
	<ItemGroup>
		<Content Include="..\ResourceFlow.Infrastructure\Persistence\StoredProcedures\*.sql">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Link>StoredProcedures\%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>


